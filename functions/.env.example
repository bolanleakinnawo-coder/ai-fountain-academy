# Copy to functions/.env (never commit it). Non-secret config only.
# The full public URL of the site, used for Paystack's callback redirect.
APP_BASE_URL=https://your-project.web.app
# Lifetime of signed video URLs, in minutes.
PLAYBACK_URL_MINUTES=120

# Secrets are NOT stored here. Set them with:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
