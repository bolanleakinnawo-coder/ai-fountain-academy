rules_version = '2';

// AI Fountain Academy security rules.
// The browser can only read what it is allowed to see. Anything that grants
// access (entitlements, payments, audit log) is written by Cloud Functions only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }

    // ---- Users -------------------------------------------------------------
    // Role is NOT stored here. Admin is an Auth custom claim set server-side.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && onlyKeys(['fullName', 'email', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.fullName.size() < 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'lastLesson', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.fullName.size() < 80;
      allow delete: if false;
    }

    // ---- Courses (public catalogue) ----------------------------------------
    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.slug is string
        && request.resource.data.priceKobo is int
        && request.resource.data.priceKobo >= 0
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if isAdmin();

      // Lesson metadata (titles, descriptions, durations) is public for
      // published lessons so the course page can show the content list.
      // The video reference lives in /lessonAssets and is never readable.
      match /lessons/{lessonId} {
        allow read: if isAdmin() || (
          resource.data.status == 'published' &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        );
        allow create, update: if isAdmin()
          && request.resource.data.title is string
          && request.resource.data.order is int
          && request.resource.data.status in ['draft', 'published'];
        allow delete: if isAdmin();
      }
    }

    // Private video references. Only admins (and Cloud Functions) touch these.
    match /lessonAssets/{lessonId} {
      allow read, write: if isAdmin();
    }

    // ---- Access and money: server-only writes -------------------------------
    match /entitlements/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /payments/{reference} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Progress (each user owns their own) --------------------------------
    match /progress/{uid}/lessons/{lessonId} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && onlyKeys(['courseId', 'completed', 'positionSeconds', 'lastAccessedAt'])
        && request.resource.data.courseId is string
        && request.resource.data.completed is bool
        && request.resource.data.positionSeconds is number
        && request.resource.data.positionSeconds >= 0;
      allow delete: if isSelf(uid);
    }

    // Collection-group reads (admin overview counts lessons across courses).
    match /{path=**}/lessons/{lessonId} {
      allow read: if isAdmin();
    }

    // ---- Site settings (landing preview video etc.) -------------------------
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
